	},
	"dependencies": {
		"@mlc-ai/web-llm": "0.2.82"
	},
	"devDependencies": {
		"@babel/plugin-transform-react-jsx": "7.25.7",
		"@babel/preset-env": "7.25.7",
		"@wordpress/scripts": "^31.2.0",
		"babel-loader": "9.2.1"
	}
}
